diff --git a/common/spl/spl_fit.c b/common/spl/spl_fit.c
index 49b4df60..aef8ee98 100644
--- a/common/spl/spl_fit.c
+++ b/common/spl/spl_fit.c
@@ -681,7 +681,7 @@ static int spl_simple_fit_read(struct spl_fit_info *ctx,
 			       struct spl_load_info *info, ulong offset,
 			       const void *fit_header)
 {
-	unsigned long count, size;
+	unsigned long size, pos, chunk, count;
 	void *buf;
 
 	/*
@@ -702,13 +702,29 @@ static int spl_simple_fit_read(struct spl_fit_info *ctx,
 	 */
 	size = get_aligned_image_size(info, size, 0);
 	buf = board_spl_fit_buffer_addr(size, size, 1);
-
-	count = info->read(info, offset, size, buf);
+	/*
+	 * The sunxi SPL MMC driver transfers data through the controller FIFO
+	 * using the CPU/FIFO path. Multi-block reads fail on this H618 board even
+	 * though single-block reads work, so issue one block per command here.
+	 * This is slower but avoids relying on the broken SPL CMD18 path.
+	 */
+	for (pos = 0; pos < size; pos += chunk) {
+		chunk = min(size - pos, (ulong)spl_get_bl_len(info));
+		count = info->read(info, offset + pos, chunk,
+				   (char *)buf + pos);
+		if (count != chunk) {
+			printf("SPL FIT chunk read failed: offset=%lu expected=%lu got=%lu\n",
+			       pos, chunk, count);
+			return -EIO;
+		}
+	}
 	ctx->fit = buf;
+	printf("SPL FIT read: total=%lu aligned=%lu bytes=%lu\n",
+	       (ulong)fdt_totalsize(fit_header), size, pos);
 	debug("fit read offset %lx, size=%lu, dst=%p, count=%lu\n",
-	      offset, size, buf, count);
+	      offset, size, buf, pos);
 
-	return (count == 0) ? -EIO : 0;
+	return 0;
 }
 

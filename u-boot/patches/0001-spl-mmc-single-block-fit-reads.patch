 	if (spl_load_simple_fit_skip_processing())
@@ -758,8 +776,10 @@ int spl_load_simple_fit(struct spl_image_info *spl_image,
 	ctx.fit = spl_load_simple_fit_fix_load(ctx.fit);
 
 	ret = spl_simple_fit_parse(&ctx);
-	if (ret < 0)
+	if (ret < 0) {
+		printf("SPL FIT parse stage failed: %d\n", ret);
 		return ret;
+	}
 
 	if (IS_ENABLED(CONFIG_SPL_FPGA))
 		spl_fit_load_fpga(&ctx, info, offset);
@@ -788,13 +808,16 @@ int spl_load_simple_fit(struct spl_image_info *spl_image,
 	if (node < 0) {
 		debug("%s: Cannot find u-boot image node: %d\n",
 		      __func__, node);
+		printf("SPL FIT firmware/loadables lookup failed: %d\n", node);
 		return -1;
 	}
 
 	/* Load the image and set up the spl_image structure */
 	ret = load_simple_fit(info, offset, &ctx, node, spl_image);
-	if (ret)
+	if (ret) {
+		printf("SPL FIT primary image load failed: %d\n", ret);
 		return ret;
+	}
 
 	/*
 	 * For backward compatibility, we treat the first node that is
@@ -811,8 +834,10 @@ int spl_load_simple_fit(struct spl_image_info *spl_image,
 	 */
 	if (os_takes_devicetree(spl_image->os)) {
 		ret = spl_fit_append_fdt(spl_image, info, offset, &ctx);
-		if (ret < 0 && spl_image->os != IH_OS_U_BOOT)
+		if (ret < 0 && spl_image->os != IH_OS_U_BOOT) {
+			printf("SPL FIT FDT append failed: %d\n", ret);
 			return ret;
+		}
 	}
 
 	firmware_node = node;
@@ -837,6 +862,7 @@ int spl_load_simple_fit(struct spl_image_info *spl_image,
 		if (ret < 0 && ret != -EPERM) {
 			printf("%s: can't load image loadables index %d (ret = %d)\n",
 			       __func__, index, ret);
+			printf("SPL FIT loadable failed: %d\n", ret);
 			return ret;
 		}
 

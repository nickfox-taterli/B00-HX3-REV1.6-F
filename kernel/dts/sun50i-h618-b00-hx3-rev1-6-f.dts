// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * B00-HX3-REV1.6-F (Allwinner H618, 4 GiB DDR3, 128 GiB eMMC)
 *
 * Base: mainline sun50i-h618-transpeed-8k618-t.dts (v6.18), adjusted per
 * community-verified settings for the matching Transpeed M98 PCB
 * (ophub/fnnas issue #500), checked against the running board:
 *
 *  - Onboard RTL8211F GbE PHY on EMAC0, MDIO address 1, reset on PI16.
 *    phy-mode = "rgmii-id": the RTL8211F PHY inserts both 2 ns RGMII delays
 *    (drivers/net/phy/realtek), the sun8i EMAC adds none because we do not
 *    pass allwinner,tx/rx-delay-ps. No delay is configured twice.
 *    The board-local emac0 pin group covers PI0..PI15 only, leaving PI16
 *    usable as the PHY reset GPIO (mainline ext_rgmii_pins claims PI16,
 *    which would conflict; the vendor group for this board omits it).
 *  - SD card (mmc0) has no card-detect GPIO wired on this PCB; the reference
 *    DTB uses broken-cd and PI16 is the PHY reset, so mainline's
 *    cd-gpios = PI16 must NOT be used here.
 *  - Wi-Fi/BT are not fitted: mmc1 (SDIO), its pwrseq and uart1 (BT) are
 *    left disabled.
 *  - eMMC keeps the mainline 8K618-T settings (HS200/DDR 1.8 V). The
 *    reference DTB additionally claims mmc-hs400-1_8v / mmc-ddr-3_3v and a
 *    150 MHz cap; those are vendor-kernel results, unverified on the
 *    mainline sunxi-mmc driver, so they are intentionally not adopted.
 *  - Headless: mainline Mali Panfrost is enabled; HDMI, audio, IR and video
 *    codec interfaces remain disabled. USB host, UART0 TX console, GbE, TF
 *    and eMMC are kept.
 */

/dts-v1/;

#include "sun50i-h616.dtsi"
#include "sun50i-h616-cpu-opp.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

/ {
	model = "B00-HX3-REV1.6-F";
	compatible = "b00,hx3-rev1-6-f", "transpeed,m98-8k-plus",
		     "allwinner,sun50i-h618";

	aliases {
		ethernet0 = &emac0;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reg_vcc5v: vcc5v {
		/* board wide 5V supply directly from the DC input */
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	reg_vcc3v3: vcc3v3 {
		/* discrete 3.3V regulator */
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&cpu0 {
	cpu-supply = <&reg_dcdc2>;
};

&ehci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ir {
	status = "disabled";
};

&gpu {
	mali-supply = <&reg_dcdc1>;
	status = "okay";
};

&codec {
	status = "disabled";
};

&spdif {
	status = "disabled";
};

&mmc0 {
	vmmc-supply = <&reg_dldo1>;
	/* no card-detect line wired on this PCB; PI16 is the PHY reset */
	broken-cd;
	disable-wp;
	bus-width = <4>;
	status = "okay";
};

&mmc2 {
	vmmc-supply = <&reg_dldo1>;
	vqmmc-supply = <&reg_aldo1>;
	bus-width = <8>;
	non-removable;
	cap-mmc-hw-reset;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&pio {
	vcc-pc-supply = <&reg_aldo1>;
	vcc-pg-supply = <&reg_dldo1>;
	vcc-ph-supply = <&reg_dldo1>;
	vcc-pi-supply = <&reg_dldo1>;

	/*
	 * EMAC0 RGMII pins without PI16 (PI16 is the PHY reset GPIO here).
	 * Same pin set and drive strength as the vendor DTB for this board.
	 */
	rgmii0_pins: rgmii0-pins {
		pins = "PI0", "PI1", "PI2", "PI3", "PI4",
		       "PI5", "PI6", "PI7", "PI8", "PI9",
		       "PI10", "PI11", "PI12", "PI13", "PI14",
		       "PI15";
		function = "emac0";
		drive-strength = <40>;
	};
};

&r_i2c {
	status = "okay";

	axp313: pmic@36 {
		compatible = "x-powers,axp313a";
		reg = <0x36>;
		#interrupt-cells = <1>;
		interrupt-controller;

		vin1-supply = <&reg_vcc5v>;
		vin2-supply = <&reg_vcc5v>;
		vin3-supply = <&reg_vcc5v>;

		regulators {
			reg_aldo1: aldo1 {
				regulator-always-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc-1v8-pll";
			};

			reg_dldo1: dldo1 {
				regulator-always-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc-3v3-io-mmc";
			};

			reg_dcdc1: dcdc1 {
				regulator-always-on;
				regulator-min-microvolt = <810000>;
				regulator-max-microvolt = <990000>;
				regulator-name = "vdd-gpu-sys";
			};

			reg_dcdc2: dcdc2 {
				regulator-always-on;
				regulator-min-microvolt = <810000>;
				regulator-max-microvolt = <1100000>;
				regulator-name = "vdd-cpu";
			};

			reg_dcdc3: dcdc3 {
				regulator-always-on;
				regulator-min-microvolt = <1360000>;
				regulator-max-microvolt = <1360000>;
				regulator-name = "vdd-dram";
			};
		};
	};
};

/* Onboard RTL8211F GbE PHY; delays come from the PHY (phy-mode rgmii-id). */
&emac0 {
	pinctrl-names = "default";
	pinctrl-0 = <&rgmii0_pins>;
	phy-mode = "rgmii-id";
	phy-handle = <&ext_rgmii_phy>;
	status = "okay";
};

&mdio0 {
	ext_rgmii_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		reset-gpios = <&pio 8 16 GPIO_ACTIVE_LOW>; /* PI16 */
		reset-assert-us = <30000>;
		reset-deassert-us = <150000>;
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_ph_pins>;
	status = "okay";
};

&usbotg {
	dr_mode = "host";	/* USB A type receptable */
	status = "okay";
};

&usbphy {
	status = "okay";
};
